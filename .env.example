# API Keys for LLM services - Replace with your actual API keys
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_key_here

# Paystack Configuration
# Test key (for development)
VITE_PAYSTACK_PUBLIC_KEY_TEST=your_paystack_test_key_here
# Live key (for production)
VITE_PAYSTACK_PUBLIC_KEY_LIVE=your_paystack_live_key_here
# Current key to use (set to LIVE for production, TEST for development)
VITE_PAYSTACK_MODE=LIVE
